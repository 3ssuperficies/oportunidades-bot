# Copia a Railway → Variables (NO subas este archivo con valores reales)

# Supabase · Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La SERVICE ROLE key (secreta). Permite escribir saltando RLS. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Cuántos días hacia atrás revisar en cada corrida (2 cubre huecos si un día falla)
LOOKBACK_DAYS=2

# Opcional: límite de páginas por corrida (seguridad)
MAX_PAGES=40

# Opcional: fuente alternativa (por si cambia la ruta oficial)
# OECE_API_BASE=https://contratacionesabiertas.oece.gob.pe/api/v1/releasesAfter?format=json&order=desc

# Opcional: para PROBAR sin escribir en Supabase (imprime lo que haría)
# DRY_RUN=1

# Opcional: keywords por variable en vez de keywords.txt (separadas por coma)
# KEYWORDS=losa deportiva, piso de caucho, juegos infantiles

# ── ScraperAPI (para sortear el bloqueo por IP del OSCE) ──
# Crea cuenta gratis en scraperapi.com y pega aquí tu API key.
SCRAPER_API_KEY=
# Opcional (plan de pago): geolocaliza la IP en Perú. Déjalo vacío en el plan gratis.
# SCRAPER_COUNTRY=pe

# ── Fuente de datos ──
# 'bulk' (recomendado): baja el archivo anual OCDS del Open Contracting Partnership.
#   Confiable y sin bloqueos; NO necesita ScraperAPI. Se actualiza ~cada mes.
# 'api': la API en vivo del OECE (más fresca pero bloquea la nube y es inestable).
SOURCE=bulk
# Opcional: 0 = trae todos los procesos del año que coincidan con las keywords.
# Pon un número (p. ej. 45) para limitar a los últimos N días por fecha de release.
BULK_LOOKBACK_DAYS=0
